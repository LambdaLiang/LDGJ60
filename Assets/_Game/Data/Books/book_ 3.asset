  book_clue_index: 104
  content: "\u8FD9\u672C\u4E66\u4ECE\u67D0\u4E9B\u82B1\u7684\u5947\u5F02\u7279\u6027\u884D\u751F\u51FA\u4E86\u5176\u5185\u90E8\u5177\u6709\u7684\u7CBE\u795E\uFF0C\u975E\u5E38\u5BCC\u6709\u54F2\u7406\u3002"
  clue_content: "\u7BC7\u4E94\uFF1A\u5411\u9633\u800C\u751F\u7684\u52C7\u6C14\n\n\u82B1\u65E0\u6CD5\u5E38\u5F00\u3002\u66F4\u6709\u751A\u8005\uFF0C\u81EA\u7136\u754C\u4E2D\u6709\u4E00\u7C7B\u82B1\uFF0C\u5929\u6027\u559C\u6B22\u9633\u5149\uFF0C\u7136\u800C\u9633\u5149\u8D8A\u8DB3\uFF0C\u5B83\u5F00\u5F97\u8D8A\u65FA\uFF0C\u5374\u892A\u8272\u8D8A\u5FEB\uFF0C\u51CB\u8C22\u8D8A\u5757\uFF0C\u4F3C\u4E4E\u53EA\u4E3A\u4EAB\u53D7\u6700\u707F\u70C2\u7684\u77AC\u95F4\u3002"
