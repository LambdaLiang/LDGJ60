  book_title: "\u521D\u59CB\u9875"
  book_color: {r: 1, g: 1, b: 1, a: 1}
  book_clue_index: 110
  content: "\u8FD9\u4F3C\u4E4E\u662F\u67D0\u4E2A\u60AC\u7591\u7CFB\u5217\u4E2D\u7684\u4E00\u672C\u3002\u4E5F\u8BB8\u6211\u8BE5\u627E\u627E\u524D\u51E0\u5377\u3002"
  clue_content: "\u201C\u516C\u5171\u8BB0\u5FC6\u5E93\u5DF2\u7ECF\u762B\u75EA\u5341\u4E00\u5929\u4E86\uFF0C\u201D\u5973\u4EBA\u8BF4\uFF0C\u201C\u6211\u4EEC\u5728\u4ED3\u5E93\u91CC\u627E\u5230\u4E86\u8FD9\u4E9B\u4E1C\u897F\u3002\u51E0\u767E\u5F20\u7EB8\uFF0C\u6CBF\u7740\u4E00\u4FA7\u88C5\u8BA2\u5728\u4E00\u8D77\u3002\u201D\n\u201C\u4E66\uFF1F\u201D\n\u201C\u53EF\u80FD\u5427\u3002\u4F60\u80FD\u5E2E\u6211\u4EEC\u8BFB\u8BFB\u7B2C\u4E00\u672C\u5417\uFF1F\u201D\n\u739B\u62C9\u62FF\u6765\u4E00\u652F\u94C5\u7B14\u3002\n\u201C\u2018\u53EB\u6211\u5B9E\u739B\u5229\u3002\u2019\u8FD9\u662F\u4E00\u6761\u6307\u4EE4\u5417\uFF1F\u201D\n\u201C\u6709\u4EBA\u5728\u4ECB\u7ECD\u81EA\u5DF1\u3002\u201D\n\u201C\u8C01\uFF1F\u8FD8\u6709\uFF0C\u7EB8\u9762\u4E0A\u6709\u4E00\u9053\u68D5\u8272\u7684\u6708\u7259\u5F62\u5370\u8FF9\u3002\u201D\n\u201C\u7EE7\u7EED\u8BFB\u3002\u201D\n\u5973\u4EBA\u6162\u6162\u8BFB\u7740\u3002\u4EA4\u6362\u7AD9\u5916\uFF0C\u9001\u5976\u7684\u5361\u8F66\u9686\u9686\u9A76\u8FC7\u3002\n\u201C\u4EC0\u4E48\u65F6\u5019\u624D\u8BB2\u5230\u4FE1\u606F\uFF1F\u201D\u5979\u95EE\u3002\n\u739B\u62C9\u5728\u6905\u5B50\u91CC\u5750\u7A33\u4E86\u3002\u201C\u4E0D\u7740\u6025\u3002\u201D"
