  content: "\u597D\u65E0\u804A\u7684\u7231\u60C5\u5C0F\u8BF4\uFF0C\u5230\u5E95\u8C01\u7231\u8BFB\u3002"
  clue_content: "\uFF08\u8BDD\u53C8\u8BF4\u56DE\u6765\uFF0C\u5982\u679C\u6211\u4ED4\u7EC6\u7FFB\u9605\u8FD9\u672C\u4E66\u7684\u8BDD...\uFF09\n\n\u7B2C5\u9875\uFF1A\n\u8C6A\uFF0C\u8FD9\u91CC\u597D\u50CF\u6211\u4EEC\u554A
    \n\u2014\u2014 \u662F\u554A\uFF0C\u5A1F\uFF0C\u8FD9\u672C\u4E66\u7B80\u76F4\u590D\u523B\u4E86\u6211\u4EEC\u7684\u6545\u4E8B\n\n\u7B2C18\u9875\uFF1A\n\u5A1F\uFF0C\u4E0B\u6B21\u6211\u4EEC\u5435\u67B6\u4E86\u4E5F\u8981\u8FD9\u6837\u548C\u597D
    \n\u2014\u2014 \u597D~~\n\n\u7B2C30\u9875\uFF1A\n\u8C6A\uFF0C\u7537\u5973\u4E3B\u7EC8\u4E8E\u7ED3\u5A5A\u4E86\uFF01\n\u2014\u2014\u6211\u4EEC\u4E5F\u4F1A\u7ED3\u5A5A\u7684\uFF01\n\n\uFF08\u4EE5\u4E0B\u4F3C\u4E4E\u662F\u53E6\u4E00\u4E2A\u7B14\u8FF9\uFF09\n\u6211\u80FD\u8BFB\u5B8C\u8FD9\u672C\u4E66\u5168\u9760\u4F60\u4FE9"
